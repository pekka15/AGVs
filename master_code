        processIncomingMessageStation(testMessage);
      else if (operatingMode == 2)
        processIncomingMessageContinuous(testMessage);
      else if (operatingMode == 3)
        processIncomingMessageCommand(testMessage);
      locationDisplayDirty = true;
    }
  }

  if (locationDisplayDirty)
  {
    locationDisplayDirty = false;
    refreshHMIFromMemory();
  }

  if (hmiRefreshActive)
  {
    if (millis() - lastHMIRefresh >= 80)
    {
      lastHMIRefresh = millis();
      refreshHMIFromMemory();
    }
    if (millis() - hmiRefreshStartTime >= 500)
      hmiRefreshActive = false;
  }
}

