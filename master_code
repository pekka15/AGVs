// Shared Station 7 -> Loading Buffer gate for all operating modes.
// Reservation remains held if an outgoing movement command fails delivery.
bool canReleaseStation7ToLoadingBuffer(const String &agvName)
{
  if (station7AGV != agvName)
  {
    Serial.println("Station 7 request ignored: AGV does not own Station 7");
    return false;
  }

  if (loadingBufferOccupied || loadingBufferReserved)
  {
    Serial.println("Station 8 occupied/reserved; holding AGV at Station 7");
    return false;
  }

  return true;
}

void reserveLoadingBufferFor(const String &agvName)
{
  loadingBufferReserved = true;
  loadingBufferReservedAGV = agvName;
  Serial.print("Station 8 reserved for ");
  Serial.println(agvName);
}

void handleLoadingArrival(const String &agvName, const String &location)
{
  if (location == "BUFFER")
  {
    if (loadingBufferReserved && loadingBufferReservedAGV != agvName)
    {
      Serial.println("WARNING: Station 8 arrival conflicts with existing reservation");
    }
    if (loadingBufferReservedAGV == agvName)
    {
      loadingBufferReserved = false;
      loadingBufferReservedAGV = "";
    }
    loadingBufferOccupied = true;
    loadingBufferAGV = agvName;

    Serial.print(agvName);
    Serial.println(" arrived at LOADING BUFFER (Station 8)");
  }
  else if (location == "STATION")
  {
    loadingStationOccupied = true;
    loadingStationAGV = agvName;

    Serial.print(agvName);
    Serial.println(" arrived at LOADING STATION (Station 9)");
  }
}


void handleLoadingBufferMoveRequest(const String &agvName)
{
  if (loadingBufferAGV != agvName)
  {
    sendToAGVByName(agvName, "WAIT");
    return;
  }

  if (!loadingStationOccupied)
  {
    loadingBufferOccupied = false;
    loadingBufferAGV = "";

    sendToAGVByName(agvName, "CONTINUE_15");

    Serial.println("LOADING BUFFER -> LOADING STATION allowed");
  }
  else
  {
    sendToAGVByName(agvName, "WAIT");

    Serial.println("LOADING STATION occupied, wait at LOADING BUFFER");
  }
}



