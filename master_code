// =====================================================
// ESP-NOW DELIVERY RETRY QUEUE
// Maximum five attempts per outgoing message; then move on.
// Existing station/Nextion logic is unchanged.
// =====================================================
constexpr uint8_t TX_QUEUE_SIZE = 64;
constexpr unsigned long TX_RETRY_MS = 300;
constexpr unsigned long TX_CALLBACK_TIMEOUT_MS = 1500;
constexpr uint8_t TX_MAX_ATTEMPTS = 5;

struct PendingTx
{
  uint8_t mac[6];
  char command[32];
  uint8_t agvIndex;
};

PendingTx txQueue[TX_QUEUE_SIZE];
uint8_t txHead = 0;
uint8_t txTail = 0;
uint8_t txCount = 0;
bool txAwaitingCallback = false;
unsigned long txNextAttemptAt = 0;
unsigned long txAttemptStartedAt = 0;
uint8_t txAttempts = 0;

portMUX_TYPE txMux = portMUX_INITIALIZER_UNLOCKED;
volatile int txCallbackResult = 0; // 0=pending, 1=success, -1=fail

void onDataSent(const wifi_tx_info_t *info, esp_now_send_status_t status)
{
  // Wi-Fi callback: record only; process on main loop.
  portENTER_CRITICAL(&txMux);
  txCallbackResult = (status == ESP_NOW_SEND_SUCCESS) ? 1 : -1;
  portEXIT_CRITICAL(&txMux);
}

void finishCurrentTx(bool delivered)
{
  Serial.print(delivered ? "ESP-NOW DELIVERY SUCCESS -> "
                         : "ESP-NOW DELIVERY FAILED (5 attempts) -> ");
  Serial.print(agvs[txQueue[txHead].agvIndex].name);
  Serial.print(": ");
  Serial.println(txQueue[txHead].command);

  txHead = (txHead + 1) % TX_QUEUE_SIZE;
  txCount--;
  txAttempts = 0;
  txAwaitingCallback = false;
  txNextAttemptAt = millis();
}

void serviceESPNowTxQueue()
{
  if (txCount == 0) return;

  int result;
  portENTER_CRITICAL(&txMux);
  result = txCallbackResult;
  txCallbackResult = 0;
  portEXIT_CRITICAL(&txMux);

  if (txAwaitingCallback)
  {
    if (result == 1)
    {
      finishCurrentTx(true);
      return;
    }

    if (result == -1 ||
        millis() - txAttemptStartedAt >= TX_CALLBACK_TIMEOUT_MS)
    {
      txAwaitingCallback = false;
      if (result == 0)
        Serial.println("ESP-NOW delivery callback timeout");

      if (txAttempts >= TX_MAX_ATTEMPTS)
      {
        finishCurrentTx(false);
        return;
      }

      Serial.print("ESP-NOW DELIVERY FAIL; retry ");
      Serial.print(txAttempts + 1);
      Serial.print("/5 -> ");
      Serial.print(agvs[txQueue[txHead].agvIndex].name);
      Serial.print(": ");
      Serial.println(txQueue[txHead].command);
      txNextAttemptAt = millis() + TX_RETRY_MS;
    }
    else
    {
      return;
    }
  }

  if ((long)(millis() - txNextAttemptAt) < 0) return;
  if (txAttempts >= TX_MAX_ATTEMPTS)
  {
    finishCurrentTx(false);
    return;
  }

  message outgoing = {};
  strncpy(outgoing.text, txQueue[txHead].command, sizeof(outgoing.text) - 1);

  portENTER_CRITICAL(&txMux);
  txCallbackResult = 0;
  portEXIT_CRITICAL(&txMux);

  esp_err_t err = esp_now_send(txQueue[txHead].mac,
                               (const uint8_t *)&outgoing, sizeof(outgoing));
  txAttempts++;
  if (err == ESP_OK)
  {
    txAwaitingCallback = true;
    txAttemptStartedAt = millis();
  }
  else
  {
    Serial.print("ESP-NOW send error ");
    Serial.print((int)err);
    Serial.print(" -> ");
    Serial.print(agvs[txQueue[txHead].agvIndex].name);
    Serial.print(": ");
    Serial.println(txQueue[txHead].command);
    if (txAttempts >= TX_MAX_ATTEMPTS)
      finishCurrentTx(false);
    else
      txNextAttemptAt = millis() + TX_RETRY_MS;
  }
}

void sendToAGVByName(const String &agvName, const char *cmd)
{
  for (int i = 0; i < NUM_AGVS; i++)
  {
    if (!agvName.equalsIgnoreCase(agvs[i].name)) continue;

    if (txCount >= TX_QUEUE_SIZE)
    {
      Serial.println("CRITICAL: ESP-NOW TX queue full; command NOT queued!");
      return;
    }

    PendingTx &entry = txQueue[txTail];
    memcpy(entry.mac, agvs[i].mac, 6);
    memset(entry.command, 0, sizeof(entry.command));
    strncpy(entry.command, cmd, sizeof(entry.command) - 1);
    entry.agvIndex = i;
    txTail = (txTail + 1) % TX_QUEUE_SIZE;
    txCount++;

    Serial.print("MASTER QUEUED -> ");
    Serial.print(agvName);
    Serial.print(": ");
    Serial.println(cmd);
    return;
  }

  Serial.print("Unknown AGV name: ");
  Serial.println(agvName);
}

